# このファイルを .env にコピーして、実際のキーを書いてください。
# .env は .gitignore 済みなのでコミットされません。

# Google AI Studio (https://aistudio.google.com/apikey) で取得
GEMINI_API_KEY=

# 既定で使うモデル（任意）
#   gemini-2.5-pro   : 品質重視（既定）
#   gemini-2.5-flash : 速度・コスト重視
GEMINI_MODEL=gemini-2.5-pro

# API 呼び出しのタイムアウト（ミリ秒・任意）
# GEMINI_TIMEOUT_MS=120000
